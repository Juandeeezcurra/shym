{
  "name": "shym",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create shym",
    "db:migrate:local": "wrangler d1 migrations apply shym --local",
    "db:migrate": "wrangler d1 migrations apply shym --remote",
    "db:schema": "node tools/gen-schema.mjs",
    "port": "node tools/port-code-gs.mjs",
    "import:local": "node tools/import-sheets.mjs --local",
    "import:remote": "node tools/import-sheets.mjs --remote",
    "test": "node --test tools/*.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.36.0"
  }
}
